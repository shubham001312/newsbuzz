# =============================================================================
# NewsBuzz AutoPilot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials

# --- OpenRouter AI ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# --- Firebase Admin ---
# Get this from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Paste the entire JSON content as a single line (or use FIREBASE_SERVICE_ACCOUNT_PATH)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Alternatively, point to the JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
FIREBASE_DATABASE_URL=https://newsbuzz-80ed3-default-rtdb.asia-southeast1.firebasedatabase.app

# --- Publishing Schedule ---
# How often to run the auto-publish cycle (in minutes, default: 120 = 2 hours)
PUBLISH_INTERVAL_MINUTES=120
# Minimum viral score (0-100) for hot topics to be published
MIN_VIRAL_SCORE=65
# Number of articles to seed per category on first run
SEED_PER_CATEGORY=20

# --- Server ---
PORT=8080
